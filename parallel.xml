<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="VitalGuard Suite" thread-count="2" parallel="tests">
    <listeners>
        <listener class-name="listeners.Listener1"/>
    </listeners>
    <test name="chrome test" preserve-order="true">
        <parameter name="browser" value="chrome"/>
        <parameter name="os" value="windows"/>
        <classes>
            <class name="tests.UrlValidationTest"/>
            <class name="tests.HomePageValidationTest"/>
            <class name="tests.HeartPulsePageValidationTest"/>
            <class name="tests.BloodPressurePageValidationTest"/>
            <class name="tests.AgeFactorPageValidationTest"/>
            <class name="tests.TeamDetailsPageValidationTest"/>
            <class name="tests.CalculatorFunctionalityTest"/>
            <class name="tests.ResultsPageUiTest"/>
        </classes>
    </test>
    <test name="Edge test" preserve-order="true">
        <parameter name="browser" value="edge"/>
        <parameter name="os" value="windows"/>
        <classes>
            <class name="tests.UrlValidationTest"/>
            <class name="tests.HomePageValidationTest"/>
            <class name="tests.HeartPulsePageValidationTest"/>
            <class name="tests.BloodPressurePageValidationTest"/>
            <class name="tests.AgeFactorPageValidationTest"/>
            <class name="tests.TeamDetailsPageValidationTest"/>
            <class name="tests.CalculatorFunctionalityTest"/>
            <class name="tests.ResultsPageUiTest"/>
        </classes>
    </test>
</suite>
